{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "functions": {
    "api/analyze.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(planning|courses|famille|scan|scans|favoris|reglages|bienvenue|pret|compte|connexion|mot-de-passe|camera)",
      "destination": "/"
    },
    {
      "source": "/questions/:n",
      "destination": "/"
    },
    {
      "source": "/compte/:etape",
      "destination": "/"
    }
  ]
}
